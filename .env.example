NODE_ENV=development
LOG_LEVEL=info
PORT=4200
HOST=0.0.0.0

# Required when OIDC auth lands (Wave 2 / Lane L5). The auth-server
# accounts.id (UUID v7 sub claim) of the user to bootstrap as super-admin.
# FORM_BOOTSTRAP_ADMIN_SUB=

# Required when Prisma schema lands (Wave 2 / Lane L4).
# form-postgres runs on host port 55438 (cms-postgres on 55437, trading-postgres on 55436).
# DATABASE_URL=postgres://forms:forms@localhost:55438/form_api

# Required when BullMQ + webhooks land (Wave 5 / Lane L13).
# REDIS_URL=redis://localhost:56379

# Optional: Sentry DSN for error tracking.
# SENTRY_DSN=
