// Prisma schema for form-api
// Prisma version: 7.8.0  |  Provider: postgresql
//
// Naming convention (mirrors cms-api):
//   - Prisma model names: PascalCase
//   - DB table names:     snake_case with form_ prefix via @@map
//   - DB column names:    snake_case via @map
//
// In Prisma 7 the datasource url is NOT set here.
// It is provided via prisma.config.ts (for Migrate) and via the PrismaClient
// adapter constructor (for the client at runtime). See prisma.config.ts and
// src/lib/prisma.ts.
//
// Model naming:
//   - Form-domain models: FormDefinition, FormVersion, FormSubmission, ...
//   - System models that mirror cms-api exactly (so Lane L5a code works):
//     Role, Permission, AccountRole, Session, ApiToken, AuditLog, RateLimitState

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  owner
  admin
  editor
  viewer

  @@map("workspace_role")
}

enum ExperimentStatus {
  draft
  running
  stopped

  @@map("experiment_status")
}

enum ExperimentMetric {
  submit_rate
  completion_rate
  payment_conversion

  @@map("experiment_metric")
}

enum FormType {
  main
  dynamic

  @@map("form_type")
}

enum SubmissionSource {
  link
  sdk
  iframe
  api

  @@map("submission_source")
}

enum SubmissionStatus {
  submitted
  processing
  delivered
  failed

  @@map("submission_status")
}

enum ApiTokenType {
  admin
  webhook_caller
  public_read

  @@map("api_token_type")
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed

  @@map("webhook_delivery_status")
}

// ---------------------------------------------------------------------------
// Core form tables
// ---------------------------------------------------------------------------

model FormDefinition {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  type           FormType
  title          String
  // slug is nullable — main forms may not have a public link
  slug           String?   @unique
  currentVersion Int       @map("current_version")
  // owner_account_id is stored as text (not @db.Uuid) because auth-server
  // accounts.id is carried as a JWT sub claim and we do not add a cross-service FK.
  ownerAccountId String    @map("owner_account_id")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  // workspaceId is nullable until Phase 3C.3 NOT NULL migration
  workspaceId    String?   @map("workspace_id") @db.Uuid

  workspace    Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  versions     FormVersion[]
  submissions  FormSubmission[]
  files        FormFile[]
  events       FormEvent[]
  webhooks     FormWebhook[]
  funnelEvents FormFunnelEvent[]
  experiments  FormExperiment[]

  @@index([slug])
  @@index([ownerAccountId])
  @@index([archivedAt])
  @@index([workspaceId])
  @@map("form_definitions")
}

model FormVersion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  formId      String    @map("form_id") @db.Uuid
  version     Int
  specJson    Json      @map("spec_json")
  schemaHash  String    @map("schema_hash")
  // nullable — drafts may not be published yet
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  // publishedBy stores an account_id string (not a UUID FK)
  publishedBy String?   @map("published_by")
  isCurrent   Boolean   @default(false) @map("is_current")

  form               FormDefinition          @relation(fields: [formId], references: [id], onDelete: Cascade)
  experimentVariants FormExperimentVariant[]

  @@unique([formId, version])
  @@index([formId, isCurrent])
  @@index([formId, version])
  @@map("form_versions")
}

model FormSubmission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  formId         String           @map("form_id") @db.Uuid
  // version is denormalized for fast joins (avoids a join to form_versions)
  version        Int
  // account_id is a string (not @db.Uuid) — auth-server identity, no cross-service FK
  accountId      String?          @map("account_id")
  anonymousToken String?          @map("anonymous_token")
  payloadJsonb   Json             @map("payload_jsonb")
  submittedAt    DateTime         @default(now()) @map("submitted_at") @db.Timestamptz
  ipHash         String           @map("ip_hash")
  userAgent      String           @map("user_agent")
  source         SubmissionSource
  status         SubmissionStatus @default(submitted)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz

  form       FormDefinition        @relation(fields: [formId], references: [id], onDelete: Restrict)
  files      FormFile[]
  eventFills FormEventFill[]
  deliveries FormWebhookDelivery[]
  payments   FormPayment[]

  @@index([formId, status, submittedAt])
  @@index([accountId])
  @@index([anonymousToken])
  @@index([formId, version])
  @@map("form_submissions")
}

model FormFile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  submissionId String? @map("submission_id") @db.Uuid
  // form_id nullable per spec — file may be orphaned before submission links
  formId       String? @map("form_id") @db.Uuid
  // account_id is a string (not @db.Uuid) — auth-server identity
  accountId    String? @map("account_id")
  storageKey   String  @unique @map("storage_key")
  mime         String
  size         BigInt
  sha256       String

  submission FormSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  form       FormDefinition? @relation(fields: [formId], references: [id], onDelete: Restrict)

  @@index([submissionId])
  @@index([formId])
  @@index([sha256])
  @@map("form_files")
}

// ---------------------------------------------------------------------------
// Event tables
// ---------------------------------------------------------------------------

model FormEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  eventKey       String  @unique @map("event_key")
  formId         String  @map("form_id") @db.Uuid
  currentVersion Int     @map("current_version")
  optional       Boolean @default(false)
  description    String

  form  FormDefinition  @relation(fields: [formId], references: [id], onDelete: Restrict)
  fills FormEventFill[]

  @@index([eventKey])
  @@index([formId])
  @@map("form_events")
}

// Prisma cannot model COALESCE in a composite PK.
// Two @@unique constraints enforce one fill per (event_key, account_id) and
// one fill per (event_key, anonymous_token). Uniqueness applies when both
// columns in the pair are non-null.
model FormEventFill {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  eventKey       String   @map("event_key")
  // account_id is a string (not @db.Uuid) — auth-server identity
  accountId      String?  @map("account_id")
  anonymousToken String?  @map("anonymous_token")
  submissionId   String   @map("submission_id") @db.Uuid
  filledAt       DateTime @default(now()) @map("filled_at") @db.Timestamptz

  event      FormEvent      @relation(fields: [eventKey], references: [eventKey], onDelete: Restrict)
  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@unique([eventKey, accountId], name: "event_account_uniq")
  @@unique([eventKey, anonymousToken], name: "event_token_uniq")
  @@index([eventKey, accountId])
  @@index([eventKey, anonymousToken])
  @@map("form_event_fills")
}

// ---------------------------------------------------------------------------
// Webhook tables
// ---------------------------------------------------------------------------

model FormWebhook {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  formId         String    @map("form_id") @db.Uuid
  url            String
  secretHash     String    @map("secret_hash")
  // native Postgres text[] for webhook event names (submitted | verified | failed)
  events         String[]
  active         Boolean   @default(true)
  lastDeliveryAt DateTime? @map("last_delivery_at") @db.Timestamptz
  // workspaceId is nullable until Phase 3C.3 NOT NULL migration
  workspaceId    String?   @map("workspace_id") @db.Uuid

  workspace  Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  form       FormDefinition        @relation(fields: [formId], references: [id], onDelete: Cascade)
  deliveries FormWebhookDelivery[]

  @@index([formId, active])
  @@index([workspaceId])
  @@map("form_webhooks")
}

model FormWebhookDelivery {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  webhookId           String                @map("webhook_id") @db.Uuid
  submissionId        String                @map("submission_id") @db.Uuid
  attempt             Int
  status              WebhookDeliveryStatus @default(pending)
  responseCode        Int?                  @map("response_code")
  responseBodyExcerpt String?               @map("response_body_excerpt") @db.VarChar(1024)
  scheduledAt         DateTime              @map("scheduled_at") @db.Timestamptz
  deliveredAt         DateTime?             @map("delivered_at") @db.Timestamptz

  webhook    FormWebhook    @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([webhookId, status])
  @@index([scheduledAt])
  @@map("form_webhook_deliveries")
}

// ---------------------------------------------------------------------------
// RBAC — mirrors cms-api shape exactly
// Models named Role / Permission / AccountRole (no Form prefix) so that
// Lane L5a session-service.ts can use prisma.role / prisma.accountRole / etc.
// DB tables remain form_role / form_permission / form_account_role.
// ---------------------------------------------------------------------------

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  name        String  @unique
  description String
  isSystem    Boolean @map("is_system")

  permissions  Permission[]
  accountRoles AccountRole[]

  @@map("form_role")
}

// Each row is one (action, subject) permission grant for a role.
// Mirrors cms-api Permission model (not a join-table pattern).
model Permission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  action         String
  subject        String
  conditionsJson Json?  @map("conditions_json")

  @@index([roleId])
  @@map("form_permission")
}

model AccountRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // account_id is a string (not @db.Uuid) — identity lives in auth-server.
  // We intentionally do not add a DB-level FK to a cross-service table.
  accountId String @map("account_id")
  roleId    String @map("role_id") @db.Uuid
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  scopeJson Json?    @map("scope_json")
  grantedBy String   @map("granted_by")
  grantedAt DateTime @map("granted_at") @db.Timestamptz

  @@unique([accountId, roleId])
  @@index([accountId])
  @@index([roleId])
  @@map("form_account_role")
}

// ---------------------------------------------------------------------------
// Sessions — refresh-token persistence for admin OIDC (Lane L5a)
// Model named Session (no Form prefix) so L5a can use prisma.session.
// DB table is form_session.
// ---------------------------------------------------------------------------

model Session {
  // id is an opaque refresh-token identifier (not a UUID); stored as text.
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  accountId String    @map("account_id")
  issuedAt  DateTime  @map("issued_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  userAgent String    @map("user_agent")
  ipHash    String    @map("ip_hash")

  @@index([accountId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("form_session")
}

// ---------------------------------------------------------------------------
// API Tokens — model named ApiToken so L5a can use prisma.apiToken
// ---------------------------------------------------------------------------

model ApiToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  name       String
  tokenHash  String       @unique @map("token_hash")
  type       ApiTokenType
  scopesJson Json         @map("scopes_json")
  expiresAt  DateTime?    @map("expires_at") @db.Timestamptz
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz
  // workspaceId is nullable until Phase 3C.3 NOT NULL migration
  workspaceId String?     @map("workspace_id") @db.Uuid

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([tokenHash])
  @@index([revokedAt])
  @@index([workspaceId])
  @@map("form_api_tokens")
}

// ---------------------------------------------------------------------------
// Audit log — append-only; intentionally omits updatedAt
// Model named AuditLog (no Form prefix) for consistency with cms-api.
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  actorAccountId String?  @map("actor_account_id")
  action         String
  subjectType    String   @map("subject_type")
  subjectId      String   @map("subject_id")
  diffJson       Json?    @map("diff_json")
  at             DateTime @default(now()) @db.Timestamptz
  // workspaceId is nullable until Phase 3C.3 NOT NULL migration
  workspaceId    String?  @map("workspace_id") @db.Uuid

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([actorAccountId])
  @@index([subjectType, subjectId])
  @@index([at])
  @@index([workspaceId])
  @@map("form_audit_log")
}

// ---------------------------------------------------------------------------
// Template tables (Phase 3A)
// ---------------------------------------------------------------------------

model FormTemplate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String?  @map("workspace_id") @db.Uuid // null until 3C ships
  slug          String   @unique
  title         String
  description   String?
  specJson      Json     @map("spec_json")
  category      String // 'survey' | 'lead' | 'feedback' | 'rsvp' | 'nps' | ...
  featuredOrder Int?     @map("featured_order") // null = not featured
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  uses      FormTemplateUse[]

  @@index([category, featuredOrder])
  @@index([workspaceId])
  @@map("form_templates")
}

model FormTemplateUse {
  templateId String   @map("template_id") @db.Uuid
  formId     String   @map("form_id") @db.Uuid
  usedAt     DateTime @default(now()) @map("used_at") @db.Timestamptz

  template FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, formId])
  @@map("form_template_uses")
}

// ---------------------------------------------------------------------------
// Payments (Phase 3B)
// ---------------------------------------------------------------------------

enum FormPaymentStatus {
  pending
  succeeded
  failed
  refunded

  @@map("form_payment_status")
}

// ---------------------------------------------------------------------------
// Funnel events (Phase 3B – L11)
// ---------------------------------------------------------------------------

enum FunnelEventName {
  view
  page_enter
  page_exit
  field_focus
  submit_attempt
  submit_ok
  submit_error

  @@map("funnel_event_name")
}

model FormPayment {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  submissionId          String            @map("submission_id") @db.Uuid
  stripePaymentIntentId String            @unique @map("stripe_payment_intent_id")
  amountMinor           Int               @map("amount_minor")
  currency              String // ISO 4217 lowercase
  status                FormPaymentStatus @default(pending)
  capturedAt            DateTime?         @map("captured_at") @db.Timestamptz
  stripeEventId         String?           @unique @map("stripe_event_id") // idempotency key
  stripeAccountId       String?           @map("stripe_account_id") // Connect destination

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([submissionId])
  @@index([status])
  @@map("form_payments")
}

model FormFunnelEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  formId         String          @map("form_id") @db.Uuid
  version        Int
  submissionId   String?         @map("submission_id") @db.Uuid
  anonymousToken String          @map("anonymous_token")
  eventName      FunnelEventName @map("event_name")
  pageId         String?         @map("page_id")
  fieldId        String?         @map("field_id")
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz
  ipHash         String?         @map("ip_hash")
  userAgentHash  String?         @map("user_agent_hash")

  form FormDefinition @relation(fields: [formId], references: [id], onDelete: Restrict)

  @@index([formId, occurredAt])
  @@index([formId, eventName, occurredAt])
  @@index([anonymousToken])
  @@map("form_funnel_events")
}

// ---------------------------------------------------------------------------
// A/B Experiments (Phase 3B – L14)
// ---------------------------------------------------------------------------

model FormExperiment {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  formId          String           @map("form_id") @db.Uuid
  name            String
  hypothesis      String?
  status          ExperimentStatus @default(draft)
  primaryMetric   ExperimentMetric @map("primary_metric")
  startedAt       DateTime?        @map("started_at") @db.Timestamptz
  stoppedAt       DateTime?        @map("stopped_at") @db.Timestamptz
  winnerVariantId String?          @map("winner_variant_id") @db.Uuid

  form      FormDefinition          @relation(fields: [formId], references: [id], onDelete: Cascade)
  variants  FormExperimentVariant[]
  exposures FormExperimentExposure[]

  @@index([formId, status])
  @@map("form_experiments")
}

model FormExperimentVariant {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  experimentId String   @map("experiment_id") @db.Uuid
  label        String
  versionId    String   @map("version_id") @db.Uuid
  weightBps    Int      @map("weight_bps") // basis points; total per experiment = 10000

  experiment FormExperiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  version    FormVersion            @relation(fields: [versionId], references: [id], onDelete: Restrict)
  exposures  FormExperimentExposure[]

  @@map("form_experiment_variants")
}

model FormExperimentExposure {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  experimentId   String   @map("experiment_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  anonymousToken String   @map("anonymous_token")
  accountId      String?  @map("account_id")
  exposedAt      DateTime @map("exposed_at") @db.Timestamptz

  experiment FormExperiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant    FormExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([experimentId, anonymousToken])
  @@index([experimentId, exposedAt])
  @@map("form_experiment_exposures")
}

// ---------------------------------------------------------------------------
// Rate-limit state
// Synthetic id PK + @@unique on (key, window_started_at).
// ---------------------------------------------------------------------------

model RateLimitState {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  key             String   @map("key")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz
  count           Int      @default(0)

  @@unique([key, windowStartedAt])
  @@index([key])
  @@map("form_rate_limit_state")
}

// ---------------------------------------------------------------------------
// Workspace tables (Phase 3C – L17)
// ---------------------------------------------------------------------------

model WorkspacePlan {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  slug                   String   @unique
  name                   String
  monthlySubmissionQuota Int      @map("monthly_submission_quota")
  maxForms               Int      @map("max_forms")
  maxFileSizeMb          Int      @map("max_file_size_mb")
  paymentsEnabled        Boolean  @default(false) @map("payments_enabled")
  experimentsEnabled     Boolean  @default(false) @map("experiments_enabled")
  analyticsRetentionDays Int      @map("analytics_retention_days")
  stripePriceId          String?  @map("stripe_price_id")

  workspaces Workspace[]

  @@map("workspace_plans")
}

model Workspace {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  slug               String    @unique
  name               String
  planId             String    @map("plan_id") @db.Uuid
  stripeCustomerId   String?   @unique @map("stripe_customer_id")
  createdByAccountId String    @map("created_by_account_id")
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz

  plan        WorkspacePlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  forms       FormDefinition[]
  templates   FormTemplate[]
  webhooks    FormWebhook[]
  apiTokens   ApiToken[]
  auditLogs   AuditLog[]

  @@index([planId])
  @@index([createdByAccountId])
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  accountId   String        @map("account_id")
  role        WorkspaceRole
  invitedAt   DateTime      @default(now()) @map("invited_at") @db.Timestamptz
  joinedAt    DateTime?     @map("joined_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, accountId])
  @@index([accountId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspaceId String        @map("workspace_id") @db.Uuid
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique @map("token_hash")
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime?     @map("accepted_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("workspace_invitations")
}
