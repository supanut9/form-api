{
  "id": "tpl_survey",
  "version": 1,
  "title": "General Survey",
  "type": "dynamic",
  "access": {
    "mode": "public_anonymous",
    "require_account": false
  },
  "theme": {
    "primary_color": "#4F46E5"
  },
  "pages": [
    {
      "id": "pg_1",
      "title": "About You",
      "fields": [
        {
          "id": "fld_age_range",
          "type": "select",
          "label": "Age Range",
          "required": false,
          "helpText": "Used only for demographic analysis — responses are always anonymised.",
          "options": [
            { "value": "under_18", "label": "Under 18" },
            { "value": "18_24", "label": "18–24" },
            { "value": "25_34", "label": "25–34" },
            { "value": "35_44", "label": "35–44" },
            { "value": "45_54", "label": "45–54" },
            { "value": "55_64", "label": "55–64" },
            { "value": "65_plus", "label": "65 or older" },
            { "value": "prefer_not_to_say", "label": "Prefer not to say" }
          ]
        },
        {
          "id": "fld_role",
          "type": "text",
          "label": "Your Role or Job Title",
          "required": false,
          "helpText": "e.g. Product Manager, Student, Freelance Designer"
        }
      ]
    },
    {
      "id": "pg_2",
      "title": "Usage & Habits",
      "fields": [
        {
          "id": "fld_frequency",
          "type": "radio",
          "label": "How often do you use our product?",
          "required": true,
          "helpText": "Choose the option that best matches your typical usage.",
          "options": [
            { "value": "daily", "label": "Daily" },
            { "value": "several_week", "label": "Several times a week" },
            { "value": "weekly", "label": "About once a week" },
            { "value": "monthly", "label": "A few times a month" },
            { "value": "rarely", "label": "Rarely" }
          ]
        },
        {
          "id": "fld_top_features",
          "type": "multiselect",
          "label": "Which features do you use most?",
          "required": false,
          "helpText": "Select all that apply.",
          "options": [
            { "value": "form_builder", "label": "Form Builder" },
            { "value": "analytics", "label": "Analytics Dashboard" },
            { "value": "integrations", "label": "Integrations" },
            { "value": "templates", "label": "Templates" },
            { "value": "file_uploads", "label": "File Uploads" },
            { "value": "api", "label": "API / Developer Tools" }
          ]
        }
      ]
    },
    {
      "id": "pg_3",
      "title": "Open Feedback",
      "fields": [
        {
          "id": "fld_open_ended",
          "type": "textarea",
          "label": "Is there anything else you'd like to share with us?",
          "required": false,
          "helpText": "This is your space — thoughts, ideas, wishes, complaints. We read everything."
        }
      ]
    }
  ],
  "thank_you": {
    "title": "Survey complete — thank you!",
    "body_md": "We appreciate your time completing this survey. Your responses are aggregated with others to help us make better decisions. Results may be shared in our next community update."
  }
}
